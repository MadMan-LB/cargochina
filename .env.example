# CLMS Environment Configuration
# Copy to .env and fill in values. Production defaults are intentionally safe.

# Database (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=clms
DB_USER=root
DB_PASS=

# App
APP_ENV=production
APP_DEBUG=0
APP_URL=https://your-domain.example/cargochina
ALLOW_DEMO_SEED=0

# Variance thresholds (TBD - placeholder values)
VARIANCE_THRESHOLD_PERCENT=10
VARIANCE_THRESHOLD_ABS_CBM=0.1

# Confirmation policy: variance-only | always-on-arrival
CONFIRMATION_REQUIRED=variance-only

# Photo visibility: internal-only | customer-visible
CUSTOMER_PHOTO_VISIBILITY=internal-only

# Bilingual draft-item translation.
# Providers: disabled, google, libretranslate, generic.
# Google uses the official v2 URL automatically when TRANSLATION_API_URL is blank.
# Keep the API key only in .env or the server environment, never in source control.
TRANSLATION_PROVIDER=disabled
TRANSLATION_API_URL=
TRANSLATION_API_KEY=
TRANSLATION_TIMEOUT_SECONDS=8

# Notification channels: dashboard, email, whatsapp (comma-separated)
NOTIFICATION_CHANNELS=dashboard

# Upload limits (bytes)
UPLOAD_MAX_SIZE=5242880
