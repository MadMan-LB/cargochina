# Only public static assets. Unversioned references (including CSS font URLs)
# must revalidate; content-versioned URLs can be reused across page navigation.
<IfModule mod_expires.c>
    ExpiresActive Off
</IfModule>
<IfModule mod_headers.c>
    <FilesMatch "\.(css|js|png|jpg|jpeg|gif|webp|svg|ico|woff|woff2|ttf)$">
        Header set Cache-Control "public, no-cache"
        Header set Cache-Control "public, max-age=31536000, immutable" "expr=%{QUERY_STRING} =~ /(^|&)v=[a-f0-9]{16}(&|$)/ && %{REQUEST_STATUS} == 200"
    </FilesMatch>
</IfModule>
